{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/projet-frontend/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cms-ikg2.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
